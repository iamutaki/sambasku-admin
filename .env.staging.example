# Staging (pnpm build:staging) - salin jadi .env.staging untuk build lokal.
# CI (deploy-staging.yml) TIDAK memakai file ini - VITE_* di-inject langsung
# sebagai environment variable di workflow (prioritas tertinggi Vite).
# CATATAN: kredensial ImageKit TIDAK diperlukan di frontend - alur upload
# server-driven (public_key/signature/token dari API saat runtime).
VITE_API_BASE_URL=https://sambasku-staging.iamutaki.com/api/v1
VITE_APP_NAME=Kamus Sambas - Admin Console (Staging)
