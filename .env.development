# Development (pnpm dev / vite): same-origin lewat Vite proxy (vite.config.ts
# /api -> sambasku-staging.iamutaki.com). JANGAN ubah ke absolute URL lintas
# situs — cookie refresh_token sameSite=Strict tidak terkirim kalau origin
# beda situs, dan reload akan "amnesia" (kembali ke halaman login).
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Kamus Sambas - Admin Console (Dev)