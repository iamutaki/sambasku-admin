# Base URL API. Rekomendasi: pakai path RELATIF `/api/v1` di development -
# Vite proxy (vite.config.ts) meneruskan ke backend sehingga origin tetap
# same-origin dan cookie refresh_token (sameSite=Strict) berfungsi saat
# reload (tanpa proxy: cross-site → cookie tidak terkirim → "amnesia").
#
# Absolute URL lintas situs (mis. https://api.domain.com/api/v1) hanya boleh
# dipakai kalau (1) CORS backend sudah mengizinkan origin frontend DAN
# (2) cookie dipaksa sameSite=None + secure=true di backend - lihat
# api/src/modules/auth/presentation/v1/auth.controller.ts.

# Development / dev server (vite): same-origin lewat proxy.
VITE_API_BASE_URL=/api/v1

# Tier cadangan produksi (dipisah koma). Kosong di dev - Vite proxy sudah
# same-origin, tidak ada failover. Di production diisi lewat
# .env.production / deploy-production.yml. Lihat docs/backlogs/FAILOVER.md.
VITE_API_BASE_URL_FALLBACKS=

# Nama aplikasi yang tampil di judul halaman/login.
VITE_APP_NAME=Kamus Sambas - Admin Console